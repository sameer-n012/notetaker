# code: a block of source code, rendered verbatim. The optional argument is the
# language, used for syntax highlighting. A ``` fence is equivalent.
#
# Example:
#   code(python) {
#       def f(x):
#           return x + 1
#   }

numbered: false

latex {
\begin{lstlisting}$lang_opt
$body
\end{lstlisting}
}

html {
<pre><code$class_attr>$body</code></pre>
}

# $fence is a backtick fence longer than any backtick run in the source.
markdown {
$fence${1?$1}
$body
$fence
}
