# today: the current date (HTML: filled in by JavaScript when the page is
# opened; LaTeX: emits \date{\today}). Takes no arguments or body, and is often
# nested inside a subtitle.
#
# Example:
#   subtitle {
#       today {}
#   }

numbered: false
toc: false

latex {
\date{\today}
}

html {
<p class="current_date"></p>
<script>
for (const el in document.getElementsByClassName("current_date")) {
    document.getElementsByClassName("current_date")[el].innerHTML = new Date().toLocaleDateString('en-US', 
        { year: 'numeric', month: 'long', day: 'numeric' }); }
</script>
}

# $today is the build date (UTC), since Markdown can't run scripts.
markdown {
$today
}
