numbered: true

latex {
\par\noindent\textbf{Lemma $n${1? ($1)}.}${id?\label{$id}}
$body
\par
}

html {
<div class="lemma"$id_attr>
<p class="lemma-title"><strong>Lemma $n${1? ($1)}.</strong></p>
$body
</div>
}

style {
.lemma { margin: 1.2em 0; padding: 0.75em 1em; border-left: 4px solid #4a7fd6; background: #f6f8fc; }
.lemma-title { font-weight: bold; margin: 0 0 0.4em 0; }
}
