# toc: the table of contents. It lists every numbered block whose def sets
# `toc: true` (section and subsection). Takes no arguments or body.
#
# Example:
#   toc {}

numbered: false

latex {
\tableofcontents
}

html {
<details class="toc" closed>
<summary>Table of Contents</summary>
$body
</details>
}

style {
.toc summary { cursor: pointer; font-weight: bold; margin-bottom: 0.5em; }
.toc ul { list-style: none; padding-left: 1.2em; }
.toc li { margin: 0.3em 0; }
.toc a { text-decoration: none; }
.toc a:hover { text-decoration: underline; }
}
