# subsection: a numbered heading, included in the table of contents. Nest it
# inside a `section`; it is numbered under its parent (e.g. 2.3). Argument 1 is
# the heading text.
#
# Example:
#   section(Filters) {
#       subsection(Linear filters) #ss-linear {
#           Body text.
#       }
#   }

numbered: true
toc: true

latex {
\phantomsection\addcontentsline{toc}{subsection}{$n. $1}
\subsection*{$n. $1}${id?\label{$id}}
$body
}

html {
<div class="subsection"$id_attr>
<h3>$n. $1</h3>
$body
</div>
}
