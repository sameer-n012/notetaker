# figure: a numbered figure. Argument 1 is the image path and optional
# argument 2 is the alt text (HTML only). Put a `caption` block inside it for
# the caption. The optional #id lets you refer to it elsewhere with @fig-dot.
#
# Example:
#   figure(images/diagram.png, A red dot) #fig-dot {
#       caption {
#           A caption for the figure.
#       }
#   }

numbered: true

latex {
\begin{figure}[htbp]
\centering
\includegraphics[width=0.8\textwidth]{$1}
\par\textbf{Figure $n.} $body
${id?\label{$id}}
\end{figure}
}

html {
<figure$id_attr>
<img src="$1" alt="${2?$2}">
<figcaption><strong>Figure $n.</strong> $body</figcaption>
</figure>
}

markdown {
![${2?$2}]($1)${id?<a id="$id"></a>}

**Figure $n.** $body
}

style {
figure { margin: 1.5em 0; text-align: center; }
figure img { max-width: 100%; }
figcaption { font-size: 0.9em; color: #555; margin-top: 0.5em; }
}
