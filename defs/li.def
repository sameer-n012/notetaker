# li: one list item. Use it inside a `ulist` or `olist` block.
#
# Example:
#   ulist {
#       li {
#           First item
#       }
#       li {
#           Second item, with math $x = y$
#       }
#   }

# In Markdown the parent list adds the item marker (see ulist/olist), so li
# only indents its later lines to keep nested content inside the item.
markdown_indent: "   "

latex {
\item $body
}

html {
<li>$body</li>
}

markdown {
$body
}
