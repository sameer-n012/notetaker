# table: a table. Argument 1 is the LaTeX column spec (one letter per column:
# l, c or r; e.g. `lr`), used for the PDF. Its children are `tr` (row) blocks,
# which contain `th` (header cell) and `td` (cell) blocks.
#
# Example:
#   table(lr) {
#       tr {
#           th {
#               Name
#           }
#           th {
#               Score
#           }
#       }
#       tr {
#           td {
#               Alice
#           }
#           td {
#               90
#           }
#       }
#   }

latex_join: " "
markdown_join: "\n"

latex {
\vspace{1em}
\begin{tabular}{$1}
\hline
$body
\end{tabular}
}

html {
<table>
$body
</table>
}

markdown {
$head
$md_rule
$rest
}

style {
table { border-collapse: collapse; margin: 1.2em 0; }
th, td { border: 1px solid #ccc; padding: 0.4em 0.7em; text-align: left; }
th { background: #f0f0f0; }
}
