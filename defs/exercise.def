numbered: true

latex {
\par\noindent\textbf{Exercise $n${1? ($1)}.}${id?\label{$id}}
$body
\par
}

html {
<div class="exercise"$id_attr>
<p class="exercise-title"><strong>Exercise $n${1? ($1)}.</strong></p>
$body
</div>
}

style {
.exercise { margin: 1.2em 0; padding: 0.75em 1em; border: 1px dashed #b5533c; background: #fdf5f1; }
.exercise-title { font-weight: bold; margin: 0 0 0.4em 0; }
}
