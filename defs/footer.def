# footer: small, muted text set off by a rule, for the end of the document.
#
# Example:
#   footer #foot {
#       These notes are based on the lecture by Prof. Someone.
#   }

numbered: false

latex {
\bigskip\noindent\hrulefill\par
{\small $body\par}
${id?\label{$id}}
}

html {
<footer class="footer"$id_attr>$body</footer>
}

style {
.footer { margin-top: 2em; padding-top: 0.75em; border-top: 1px solid #ddd; font-size: 0.85em; color: #777; }
}
