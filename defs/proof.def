# proof: an unnumbered proof. Often nested inside a theorem or lemma.
#
# Example:
#   theorem(Trivial) {
#       Every set is a subset of itself.
#       proof {
#           Each element of the set is an element of the set.
#       }
#   }

numbered: false

latex {
\begin{proof}
$body
\end{proof}
}

html {
<div class="proof"$id_attr>
<p class="proof-title"><strong>Proof.</strong></p>
$body
</div>
}

markdown {
*Proof.*${id?<a id="$id"></a>} $body
}

style {
.proof { margin: 1.2em 0; padding: 0.75em 1em; border-left: 4px solid #999; font-style: italic; }
.proof-title { font-weight: bold; font-style: normal; margin: 0 0 0.4em 0; }
}
