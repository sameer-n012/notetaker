# theorem: a numbered theorem. The optional argument is its title, and the
# optional #id lets you refer to it elsewhere with @thm-cs.
#
# Example:
#   theorem(Cauchy-Schwarz) #thm-cs {
#       For all vectors $u, v$: $|\langle u, v \rangle| \le \|u\| \|v\|$.
#   }
#
#   By @thm-cs, ...

numbered: true

latex {
\par\noindent\textbf{Theorem $n${1? ($1)}.}${id?\label{$id}}
$body
\par
}

html {
<div class="theorem"$id_attr>
<p class="theorem-title"><strong>Theorem $n${1? ($1)}.</strong></p>
$body
</div>
}

markdown {
**Theorem $n${1? ($1)}.**${id?<a id="$id"></a>}
$body
}

style {
.theorem { margin: 1.2em 0; padding: 0.75em 1em; border-left: 4px solid #4a7fd6; background: #f6f8fc; }
.theorem-title { font-weight: bold; margin: 0 0 0.4em 0; }
}
