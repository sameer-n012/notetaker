# th: a bold table header cell. Use it inside a `tr` block (see `table`).
#
# Example:
#   tr {
#       th {
#           Name
#       }
#       th {
#           Score
#       }
#   }

latex {
\textbf{$body}
}

html {
<th>$body</th>
}

# The first row of a Markdown table is always its header row, so no bold.
markdown {
$body
}
