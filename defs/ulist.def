# ulist: an unordered (bulleted) list. Its children are `li` blocks.
#
# Example:
#   ulist {
#       li {
#           First item
#       }
#       li {
#           Second item
#       }
#   }

markdown_join: "\n- "

latex {
\begin{itemize}
$body
\end{itemize}
}

html {
<ul>
$body
</ul>
}

markdown {
- $body
}
