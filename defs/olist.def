# olist: an ordered (numbered) list. Its children are `li` blocks.
#
# Example:
#   olist {
#       li {
#           Step one
#       }
#       li {
#           Step two
#       }
#   }

# Markdown: each `li` child starts on a new line with a `1. ` marker (Markdown
# viewers number the items in sequence).
markdown_join: "\n1. "

latex {
\begin{enumerate}
$body
\end{enumerate}
}

html {
<ol>
$body
</ol>
}

markdown {
1. $body
}
