# link: a hyperlink. Argument 1 is the URL and argument 2 is the link text. It
# takes no body, so write it as an empty one-liner on its own line (blocks
# can't be embedded in the middle of a sentence).
#
# Example:
#   link(https://example.com, the docs) {}

latex {
\href{$1}{$2}
}

html {
<a href="$1">$2</a>
}
