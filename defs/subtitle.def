# subtitle: italic text shown under the title. Use one block per line.
#
# Example:
#   title(Filters) {}
#   subtitle {
#       Sameer Narendran
#   }

numbered: false

latex {
\par{\Large\itshape $body\par}
}

html {
<div class="subtitle">$body</div>
}

markdown {
*$body*
}

style {
.subtitle { font-size: 1.2em; font-style: italic; color: #555; margin-top: -0.5em; margin-bottom: 1.0em; }
}
